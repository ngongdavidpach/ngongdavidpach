# ─────────────────────────────────────────────────────────────
# Junub Pay — environment configuration
# Copy to `.env` and adjust. All values have safe demo defaults.
# ─────────────────────────────────────────────────────────────

# Base URL of the running app
APP_URL=http://localhost:3000

# Secret used to sign session JWTs (generate a long random string in prod)
JUNUB_SESSION_SECRET=dev-secret-change-me-in-production-32chars

# Where the SQLite database lives (created on first run)
JUNUB_DB_PATH=./data/junubpay.sqlite

# ── Mock Mobile Money provider credentials ──
# In production these come from the MTN MoMo & Zain Cash developer portals.
MTN_MOMO_API_USER=junub-mtn-demo
MTN_MOMO_API_KEY=dev-mtn-key
MTN_MOMO_SUBSCRIPTION_KEY=dev-mtn-sub-key
MTN_MOMO_ENV=sandbox

ZAIN_CASH_MERCHANT_ID=junub-zain-demo
ZAIN_CASH_MERCHANT_SECRET=dev-zain-secret
ZAIN_CASH_ENV=sandbox
